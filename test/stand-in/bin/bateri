#!/bin/sh
# Stands in for bateri in the tests: nothing here reaches a bateri app or opens a pane.
#
# It records each call in $STANDIN_BATERI_LOG: every argument followed by a NUL, then a byte 1 and a
# NUL where the call ends (a prompt holds line breaks, so a line is not an argument).
#
#   split, tab   say the id of the pane made, p41, which runs until it is waited for
#   wait         returns at once, or, with STANDIN_WAIT set, when that file is gone; then p41 has ended
#   ls --json    tells the terminals as bateri does (it says more of each than the pen reads): p41,
#                running claude, while it runs, and nothing else. Its name is ACM-412: its own where
#                it was split, its tab's where it was made a tab (bateri puts `tab --label` on the
#                tab). Its `output_at` is what the file STANDIN_OUTPUT_AT holds, seconds since the
#                epoch, read at each call, and is left out where there is no such file
#   focus        does nothing
#
# That p41 runs, and how it was made, is a file beside the log ($STANDIN_BATERI_LOG.p41), so that a
# pen begun again sees the pane the one before it made.
#
#   STANDIN_BATERI=refuse   split and tab fail as bateri does where no app answers: exit 69
if [ -n "${STANDIN_BATERI_LOG-}" ]; then
	# One write for the whole record: calls run at the same time (the panes are looked at while one
	# is waited for), and a record written in two pieces would be mixed with another's. So it is
	# made in a file of its own and put in the log by one `cat`.
	mine="$STANDIN_BATERI_LOG.$$"
	{
		printf '%s\0' "$@"
		printf '\001\0'
	} >"$mine"
	cat "$mine" >>"$STANDIN_BATERI_LOG"
	rm -f "$mine"
fi

running="${STANDIN_BATERI_LOG:-/nonexistent/stand-in}.p41"

case "${1-}" in
split | tab)
	if [ "${STANDIN_BATERI-}" = refuse ]; then
		echo "bateri: the bateri app is not connected" >&2
		exit 69
	fi
	echo "$1" >"$running" 2>/dev/null || true
	echo p41
	;;
ls)
	at=""
	if [ -n "${STANDIN_OUTPUT_AT-}" ] && [ -f "$STANDIN_OUTPUT_AT" ]; then
		at=$(cat "$STANDIN_OUTPUT_AT")
	fi
	field=""
	if [ -n "$at" ]; then field=",\"output_at\":$at"; fi
	made=""
	if [ -f "$running" ]; then made=$(cat "$running"); fi
	case "$made" in
	split)
		printf '{"windows":null,"terminals":[{"id":"p41","state":"running","activity":"running","program":"claude","exit":null%s,"label":"ACM-412","tab":null}]}\n' "$field"
		;;
	tab)
		printf '{"windows":[{"id":"w1","visible":true,"groups":[],"tabs":[{"id":"t7","group":null,"label":"ACM-412","title":"claude","selected":false}]}],"terminals":[{"id":"p41","state":"running","activity":"running","program":"claude","exit":null%s,"label":null,"tab":"t7"}]}\n' "$field"
		;;
	*)
		printf '{"windows":null,"terminals":[]}\n'
		;;
	esac
	;;
wait)
	if [ -n "${STANDIN_WAIT-}" ]; then
		while [ -e "$STANDIN_WAIT" ]; do sleep 0.05; done
	fi
	rm -f "$running"
	;;
focus) ;;
*)
	echo "stand-in bateri: a command it does not know" >&2
	exit 64
	;;
esac
