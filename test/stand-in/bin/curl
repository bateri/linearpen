#!/bin/sh
# Stands in for curl in the tests: nothing here reaches the network.
#
# linearpen runs `curl --config -` and gives the configuration (the address, the key, the body) on
# stdin. This reads it, records the call in $STANDIN_LOG (the arguments, whether the environment has
# LINEAR_API_KEY, and the stdin), and answers with the file of test/stand-in/ that the query's name
# asks for, then a line break and an HTTP status, as curl's write-out does.
#
#   STANDIN_MODE=refused   Linear refuses the key: HTTP 401
#   STANDIN_MODE=errors    GraphQL errors, HTTP 400
#   STANDIN_MODE=broken    a body that is not JSON, HTTP 200
#   STANDIN_MODE=down      curl could not resolve the host: exit 6, no output
#   STANDIN_MY=empty       the person has no issues assigned
#   STANDIN_LIST=big       a team has more issues than the pen takes (500): every page of it has a next
#   (A search, and the choices of the filters: search-issues.json, filter-options.json.)
#   (The lists a person can go to: the issues of a team, a cycle, a view, a project and a label are
#   each a file of their own, and the names are list-*.json: three favorites, three teams, five views
#   of issues and a view of projects, two projects.)
#   STANDIN_CREATE=refused    Linear does not make the issue: a GraphQL error, HTTP 400
#   STANDIN_CREATE=forbidden  the key may not create issues: HTTP 403
#   STANDIN_CREATE=lost       Linear makes the issue and the answer never comes: curl times out
#   STANDIN_CHANGE=refused    Linear does not make the change: a GraphQL error, HTTP 400
#   STANDIN_CHANGE=lost       Linear makes the change and the answer never comes: curl times out
#   STANDIN_COMMENT=refused   Linear does not post the comment: a GraphQL error, HTTP 400
#   STANDIN_COMMENT=forbidden the key may not comment: HTTP 403
#   STANDIN_COMMENT=lost      Linear posts the comment and the answer never comes: curl times out
#   STANDIN_COMMENT=theirs    `Comment` tells the comment asked for as someone else's (else it is the
#                             person's: Mert's words of issue.json, written by Ada, on ACM-412)
#   STANDIN_EDIT=refused      Linear does not edit the comment (CommentUpdate): a GraphQL error, HTTP 400
#   STANDIN_EDIT=lost         Linear edits it and the answer never comes: curl times out
#   STANDIN_PUT=refused       the storage a file is sent to does not take it: HTTP 403
#   (A file of Linear: a GET of an address with `max-filesize` in the configuration. It answers with
#   a picture of test/stand-in/ by the name the address ends in (.jpg, .gif, .webp, else a PNG), and
#   `.../big` exceeds the size (curl exits 63), `.../missing` is an HTTP error (22), `.../moved` is sent
#   on to cdn.stand-in (a redirect, 302), `.../moved-away` to a place that is not https and
#   `.../moved-forever` to itself, `.../text` is a
#   file that is no picture, a name that ends in .log is two lines of words. A file sent to the
#   storage (`request = "PUT"` in the configuration) is kept in "$STANDIN_LOG.put.N", N the order it
#   came in, and answered with HTTP 200; `FileUpload` answers the place:
#   https://storage.stand-in/put/N?sig=SECRET and the file's address
#   https://uploads.linear.app/stand-in/N.)
#   STANDIN_ISSUE=todo        `Issue` tells the issue it answers with (issue.json) as one in Todo, which
#                             has not begun, where it is In Progress
#   STANDIN_ISSUE=family      `Issue` tells it with sub-issues and ties of each kind (issue-family.json),
#                             where issue.json has a parent and one issue that blocks it
#   STANDIN_ISSUE=pictures    `Issue` tells it with pictures in its description and its first comment
#                             (issue-pictures.json): the ones of the address names above, and one that
#                             is not on uploads.linear.app
#   STANDIN_ISSUE=moved       the same, with three of the files sent on elsewhere (`.../moved`,
#                             `.../moved-away`, `.../moved-forever`)
#   STANDIN_ISSUE=pictures-uuid  the same, with a UUID as the issue's id
#   STANDIN_ISSUE=mine        `Issue` tells issue.json with its last comment (Mert's words) written by
#                             the person (Ada), which is theirs to edit
#   STANDIN_ISSUE=odd-title   `Issue` tells issue.json with a title that begins with dashes and holds a
#                             line end, an escape and a bell
#
# Each call is recorded with how many calls the stand-in `bateri` (STANDIN_BATERI_LOG) had had by
# then, so that a test can say which came first: Linear or the pane.
#
# An issue that was created (by IssueCreate, answered or lost) is kept in "$STANDIN_LOG.created" (its
# id and its title): the lists tell it first from then on, and `Issue` finds it by that id. An id
# that is a UUID and not that one is not found; any other id is the issue of issue.json.
#
# A change (IssueBatchUpdate, answered or lost) is kept in "$STANDIN_LOG.changed", a line to each
# field of each issue (its id, the field and the value): the lists tell the title, the priority and
# the state of an issue as it was last changed to, and leave out one that is done or canceled, which
# only the question for the closed issues of a list tells (no other issue is closed). The
# answer is each issue as the fixtures hold it with its changes, the state and the labels apart: the
# state is the one it was changed to (else In Progress), the person the one it was given to (else
# Ada), the labels those that were added and not removed since, the cycle, the estimate and the due
# date those it was given (else none). Nothing else of a list changes.
here=$(cd "$(dirname "$0")/.." && pwd)
config=$(cat)

# One write for the whole record: calls run at the same time (the lists are asked for while an
# issue is made), and a record in pieces would be mixed with another's. The shell's `printf` writes a
# long record in pieces, so it is made in a file of its own and put in the log by one `cat`.
if [ -n "${STANDIN_LOG-}" ]; then
	nl='
'
	record="--- call$nl"
	for arg in "$@"; do
		record="${record}argv: $arg$nl"
	done
	if [ -n "${LINEAR_API_KEY+x}" ]; then
		record="${record}env LINEAR_API_KEY: set$nl"
	else
		record="${record}env LINEAR_API_KEY: unset$nl"
	fi
	seen=0
	if [ -n "${STANDIN_BATERI_LOG-}" ] && [ -f "$STANDIN_BATERI_LOG" ]; then
		seen=$(tr -cd '\001' <"$STANDIN_BATERI_LOG" | wc -c | tr -d ' ')
	fi
	record="${record}bateri calls so far: $seen$nl"
	record="${record}stdin:$nl$config$nl--- end$nl"
	mine="$STANDIN_LOG.$$"
	printf '%s' "$record" >"$mine"
	cat "$mine" >>"$STANDIN_LOG"
	rm -f "$mine"
fi

case "${STANDIN_MODE-}" in
refused)
	cat "$here/refused.json"
	printf '\n401'
	exit 0
	;;
errors)
	cat "$here/errors.json"
	printf '\n400'
	exit 0
	;;
broken)
	printf 'this is not json\n200'
	exit 0
	;;
down)
	echo "curl: (6) Could not resolve host" >&2
	exit 6
	;;
esac

# A file sent to the storage Linear named: a `PUT` of the file `upload-file` names. It is copied to
# "$STANDIN_LOG.put.N" before curl's caller puts it away.
case "$config" in
*'request = "PUT"'*)
	if [ -n "${STANDIN_LOG-}" ]; then
		file=$(printf '%s\n' "$config" | sed -n 's/^upload-file = "\(.*\)"$/\1/p')
		n=$(ls "$STANDIN_LOG".put.* 2>/dev/null | wc -l | tr -d ' ')
		n=$((n + 1))
		cp "$file" "$STANDIN_LOG.put.$n"
	fi
	if [ "${STANDIN_PUT-}" = refused ]; then
		printf '\n403'
	else
		printf '\n200'
	fi
	exit 0
	;;
esac

# A file of Linear (or the place Linear sent it on to): a GET with a size to keep to. After the body
# curl writes what `write-out` asks for: a line break, the status, a line break, the address of a
# redirect (none otherwise) and a line break. An address with `/moved` in it is sent on to the same name
# on cdn.stand-in; `/moved-away` is sent on to a place that is not https; an address on cdn.stand-in is
# the file, and the key is not given there.
case "$config" in
*'max-filesize'*)
	address=$(printf '%s\n' "$config" | sed -n 's/^url = "\(.*\)"$/\1/p')
	case "$address" in
	*/big*) exit 63 ;;
	*/missing*) exit 22 ;;
	https://cdn.stand-in/*) cat "$here/picture.png" ;;
	*/moved-away*) printf '\n302\nhttp://cdn.stand-in/away.png\n' ; exit 0 ;;
	*/moved-forever*) printf '\n302\nhttps://uploads.linear.app/stand-in/moved-forever.png\n' ; exit 0 ;;
	*/moved*)
		name=${address##*/}
		printf 'a redirect has a body that is not the file\n302\nhttps://cdn.stand-in/%s\n' "$name"
		exit 0
		;;
	*/text*) printf 'this is not a picture' ;;
	*.log*) printf 'line one\nline two\n' ;;
	*.jpg*) cat "$here/picture.jpg" ;;
	*.gif*) cat "$here/picture.gif" ;;
	*.webp*) cat "$here/picture.webp" ;;
	*) cat "$here/picture.png" ;;
	esac
	printf '\n200\n\n'
	exit 0
	;;
esac

# The body as the page's operation names it, with the quotes of the configuration undone.
plain=$(printf '%s' "$config" | sed 's/\\"/"/g')
is() {
	case "$plain" in
	*"\"operationName\":\"$1\""*) return 0 ;;
	esac
	return 1
}

created=""
changed=""
if [ -n "${STANDIN_LOG-}" ]; then
	created="$STANDIN_LOG.created"
	changed="$STANDIN_LOG.changed"
fi

# A file of test/stand-in/ with @ID@ and @TITLE@ filled in.
fill() {
	ID="$id" TITLE="$title" awk '
	function swap(s, pat, val,   out, i) {
		out = ""
		while ((i = index(s, pat)) > 0) { out = out substr(s, 1, i - 1) val; s = substr(s, i + length(pat)) }
		return out s
	}
	{ print swap(swap($0, "@ID@", ENVIRON["ID"]), "@TITLE@", ENVIRON["TITLE"]) }' "$1"
}

# A list as the changes made leave it: each issue with the title, the priority and the state it
# was last changed to, and with no issue that is done or canceled. Where there is no change, as it is.
# `settle closed` is the list of the closed issues: only the ones that were made done or canceled.
settle() {
	if [ -z "${1-}" ] && { [ -z "$changed" ] || [ ! -s "$changed" ]; }; then
		cat
		return
	fi
	awk -v changes="$changed" -v closed="${1-}" '
	function state_name(id) { return id == "s-back" ? "Backlog" : id == "s-todo" ? "Todo" : id == "s-prog" ? "In Progress" : id == "s-review" ? "In Review" : id == "s-done" ? "Done" : id == "s-cancel" ? "Canceled" : "State" }
	function state_type(id) { return id == "s-back" ? "backlog" : id == "s-todo" ? "unstarted" : id == "s-done" ? "completed" : id == "s-cancel" ? "canceled" : "started" }
	function finish(   i, line, ind, in_state, text, gone) {
		gone = ((id, "state") in set) && (state_type(set[id, "state"]) == "completed" || state_type(set[id, "state"]) == "canceled")
		if (closed != "" ? !gone : gone) return
		text = ""
		in_state = 0
		for (i = 1; i <= n; i++) {
			line = buf[i]
			match(line, /^ */)
			ind = substr(line, 1, RLENGTH)
			if (line ~ /^ *"title": / && ((id, "title") in set)) line = ind "\"title\": \"" set[id, "title"] "\","
			if (line ~ /^ *"priority": / && ((id, "priority") in set)) line = ind "\"priority\": " set[id, "priority"] ".0,"
			if (line ~ /"state": \{$/) in_state = 1
			else if (in_state && line ~ /^ *\}/) in_state = 0
			else if (in_state && ((id, "state") in set)) {
				if (line ~ /"id": /) line = ind "\"id\": \"" set[id, "state"] "\","
				if (line ~ /"name": /) line = ind "\"name\": \"" state_name(set[id, "state"]) "\","
				if (line ~ /"type": /) line = ind "\"type\": \"" state_type(set[id, "state"]) "\","
			}
			if (i == n) sub(/,$/, "", line)
			text = text (i > 1 ? "\n" : "") line
		}
		if (pending != "") print pending ","
		pending = text
	}
	BEGIN {
		while (changes != "" && (getline line < changes) > 0) {
			split(line, f, "\t")
			if (f[2] == "title" || f[2] == "priority" || f[2] == "state") set[f[1], f[2]] = f[3]
		}
	}
	{
		if (inside) {
			buf[++n] = $0
			if ($0 ~ close_re) { finish(); inside = 0 }
			next
		}
		if (held != "") {
			if ($0 ~ /^ *"id": "issue-[0-9]+",$/) {
				inside = 1
				n = 0
				buf[++n] = held
				buf[++n] = $0
				id = $0
				sub(/^ *"id": "/, "", id)
				sub(/",$/, "", id)
				indent = held
				sub(/\{$/, "", indent)
				close_re = "^" indent "\\},?$"
				held = ""
				next
			}
			if (pending != "") { print pending; pending = "" }
			print held
			held = ""
		}
		if ($0 ~ /^ *\{$/) { held = $0; next }
		if (pending != "") { print pending; pending = "" }
		print
	}
	END { if (pending != "") print pending }' 
}

# A list with the created issue, if there is one, first.
listing() {
	listed "$1" | settle
	printf '\n200'
}
listed() {
	if [ -n "$created" ] && [ -f "$created" ]; then
		id=$(sed -n 1p "$created")
		title=$(sed -n 2p "$created")
		NODE=$(fill "$here/created-issue.json") awk '
		{
			i = index($0, "\"nodes\": [")
			if (!done && i > 0) {
				rest = substr($0, i + 10)
				sep = (rest ~ /^[ ]*\]/) ? "" : ","
				print substr($0, 1, i + 9) ENVIRON["NODE"] sep rest
				done = 1
			} else print
		}' "$here/$1"
	else
		cat "$here/$1"
	fi
}

if is IssueCreate; then
	id=$(printf '%s' "$plain" | sed -n 's/.*"input":{"id":"\([^"]*\)".*/\1/p')
	title=$(printf '%s' "$plain" | sed -n 's/.*"title":"\([^"]*\)".*/\1/p')
	remember() {
		if [ -n "$created" ]; then printf '%s\n%s\n' "$id" "$title" >"$created"; fi
	}
	case "${STANDIN_CREATE-}" in
	refused)
		cat "$here/create-refused.json"
		printf '\n400'
		exit 0
		;;
	forbidden)
		printf '{"errors":[{"message":"Forbidden"}]}\n403'
		exit 0
		;;
	lost)
		remember
		echo "curl: (28) Operation timed out" >&2
		exit 28
		;;
	esac
	remember
	fill "$here/issue-create.json"
	printf '\n200'
	exit 0
fi

# A comment (CommentCreate): answered with the id it was posted under and its words; nothing of it is
# kept (the issue is told as the fixtures hold it).
if is CommentCreate; then
	id=$(printf '%s' "$plain" | sed -n 's/.*"input":{"id":"\([^"]*\)".*/\1/p')
	title=$(printf '%s' "$plain" | sed -n 's/.*"body":"\([^"]*\)".*/\1/p')
	case "${STANDIN_COMMENT-}" in
	refused)
		cat "$here/comment-refused.json"
		printf '\n400'
		exit 0
		;;
	forbidden)
		printf '{"errors":[{"message":"Forbidden"}]}\n403'
		exit 0
		;;
	lost)
		echo "curl: (28) Operation timed out" >&2
		exit 28
		;;
	esac
	fill "$here/comment-create.json"
	printf '\n200'
	exit 0
fi

# One comment by its id (Comment): the person's (STANDIN_COMMENT=theirs: someone else's), on ACM-412.
if is Comment; then
	id=$(printf '%s' "$plain" | sed -n 's/.*"variables":{"id":"\([^"]*\)".*/\1/p')
	mine=true
	if [ "${STANDIN_COMMENT-}" = theirs ]; then mine=false; fi
	printf '{"data":{"comment":{"id":"%s","body":"Keep a fallback for when Redis is down. We cannot fail closed on reads.","createdAt":"2026-11-08T16:40:00.000Z","editedAt":null,"user":{"displayName":"Ada","isMe":%s},"issue":{"id":"issue-412","identifier":"ACM-412"}}}}\n200' "$id" "$mine"
	exit 0
fi

# The edit of a comment (CommentUpdate): answered with its id and its words; nothing of it is kept.
if is CommentUpdate; then
	id=$(printf '%s' "$plain" | sed -n 's/.*"variables":{"id":"\([^"]*\)".*/\1/p')
	title=$(printf '%s' "$plain" | sed -n 's/.*"body":"\([^"]*\)".*/\1/p')
	case "${STANDIN_EDIT-}" in
	refused)
		cat "$here/comment-refused.json"
		printf '\n400'
		exit 0
		;;
	lost)
		echo "curl: (28) Operation timed out" >&2
		exit 28
		;;
	esac
	printf '{"data":{"commentUpdate":{"success":true,"comment":{"id":"%s","body":"%s","createdAt":"2026-11-08T16:40:00.000Z","editedAt":"2026-11-12T09:30:00.000Z","user":{"displayName":"Ada","isMe":true}}}}}\n200' "$id" "$title"
	exit 0
fi

# A field of the issue `$1` as the fixtures hold it, the way the file writes the value (a string has
# its quotes): the first line of that name after the issue's "id".
base() {
	awk -v id="$1" -v key="$2" '
	$0 ~ "\"id\": \"" id "\",$" { on = 1; next }
	on && $0 ~ "^ *\"" key "\": " { v = $0; sub(/^ *"[a-zA-Z]+": /, "", v); sub(/,$/, "", v); print v; exit }
	' "$here/all-issues.json" "$here/my-issues.json"
}

# What an issue was last changed to in the field `$2`, or nothing.
latest() {
	[ -f "$changed" ] || return 0
	awk -F'\t' -v id="$1" -v key="$2" '$1 == id && $2 == key { v = $3 } END { if (v != "") print v }' "$changed"
}

# The labels of the issue `$1` that were added and not removed since, as the wire writes them.
labels_of() {
	[ -f "$changed" ] || { printf '[]'; return 0; }
	awk -F'\t' -v id="$1" '
	$1 == id && $2 == "addLabel" { have[$3] = 1 }
	$1 == id && $2 == "removeLabel" { delete have[$3] }
	END {
		out = ""
		for (l in have) { name = substr(l, 3); out = out (out == "" ? "" : ",") "{\"id\":\"" l "\",\"name\":\"" name "\",\"color\":\"#3e63dd\"}" }
		printf "[%s]", out
	}' "$changed"
}

# The issue `$1` as the answer to a change tells it.
changed_node() {
	cid=$1
	cident=$(base "$cid" identifier)
	ctitle=$(latest "$cid" title)
	if [ -n "$ctitle" ]; then ctitle="\"$ctitle\""; else ctitle=$(base "$cid" title); fi
	cpriority=$(latest "$cid" priority)
	if [ -n "$cpriority" ]; then cpriority="$cpriority.0"; else cpriority=$(base "$cid" priority); fi
	cstate=$(latest "$cid" state)
	case "$cstate" in
	s-back) cstate='{"id":"s-back","name":"Backlog","type":"backlog","position":0.0}' ;;
	s-todo) cstate='{"id":"s-todo","name":"Todo","type":"unstarted","position":1.0}' ;;
	s-review) cstate='{"id":"s-review","name":"In Review","type":"started","position":3.0}' ;;
	s-done) cstate='{"id":"s-done","name":"Done","type":"completed","position":4.0}' ;;
	s-cancel) cstate='{"id":"s-cancel","name":"Canceled","type":"canceled","position":5.0}' ;;
	*) cstate='{"id":"s-prog","name":"In Progress","type":"started","position":2.0}' ;;
	esac
	cwho=$(latest "$cid" assignee)
	case "$cwho" in
	none) cwho=null ;;
	u-deniz) cwho='{"id":"u-deniz","displayName":"Deniz","isMe":false}' ;;
	u-*) cwho="{\"id\":\"$cwho\",\"displayName\":\"Someone\",\"isMe\":false}" ;;
	*) cwho='{"id":"u-ada","displayName":"Ada","isMe":true}' ;;
	esac
	ccycle=$(latest "$cid" cycle)
	case "$ccycle" in
	c-[0-9]*) ccycle="{\"id\":\"$ccycle\",\"number\":${ccycle#c-},\"name\":null}" ;;
	*) ccycle=null ;;
	esac
	cpoints=$(latest "$cid" estimate)
	case "$cpoints" in
	[0-9]*) ;;
	*) cpoints=null ;;
	esac
	cdue=$(latest "$cid" due)
	case "$cdue" in
	[0-9]*) cdue="\"$cdue\"" ;;
	*) cdue=null ;;
	esac
	printf '{"id":"%s","identifier":%s,"title":%s,"priority":%s,"updatedAt":"2026-11-11T09:30:00.000Z","url":"https://linear.app/acme/issue/%s","branchName":null,"state":%s,"labels":{"nodes":%s},"team":{"id":"team-acm","key":"ACM"},"cycle":%s,"project":null,"estimate":%s,"dueDate":%s,"assignee":%s}' \
		"$cid" "${cident:-\"ACM-0\"}" "${ctitle:-\"An issue\"}" "${cpriority:-2.0}" "$cid" "$cstate" "$(labels_of "$cid")" "$ccycle" "$cpoints" "$cdue" "$cwho"
}

if is FileUpload; then
	# Where a picture goes: the numbers are the order the places were asked for in.
	n=1
	if [ -n "${STANDIN_LOG-}" ]; then
		echo x >>"$STANDIN_LOG.uploads"
		n=$(wc -l <"$STANDIN_LOG.uploads" | tr -d ' ')
	fi
	printf '{"data":{"fileUpload":{"success":true,"uploadFile":{"uploadUrl":"https://storage.stand-in/put/%s?sig=SECRET","assetUrl":"https://uploads.linear.app/stand-in/%s","headers":[{"key":"x-stand-in","value":"yes"}]}}}}\n200' "$n" "$n"
	exit 0
fi

if is IssueBatchUpdate; then
	ids=$(printf '%s' "$plain" | sed -n 's/.*"variables":{"ids":\[\([^]]*\)\].*/\1/p' | tr -d '"' | tr ',' ' ')
	input=$(printf '%s' "$plain" | sed -n 's/.*"input":{\(.*\)}}}".*$/\1/p')
	field() { printf '%s' "$input" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }
	remember_change() {
		[ -n "$changed" ] || return 0
		value=$(field stateId)
		new_title=$(field title)
		new_priority=$(printf '%s' "$input" | sed -n 's/.*"priority":\([0-9]\).*/\1/p')
		new_who=$(field assigneeId)
		case "$input" in *'"assigneeId":null'*) new_who=none ;; esac
		added=$(printf '%s' "$input" | sed -n 's/.*"addedLabelIds":\["\([^"]*\)"\].*/\1/p')
		removed=$(printf '%s' "$input" | sed -n 's/.*"removedLabelIds":\["\([^"]*\)"\].*/\1/p')
		new_cycle=$(field cycleId)
		case "$input" in *'"cycleId":null'*) new_cycle=none ;; esac
		new_points=$(printf '%s' "$input" | sed -n 's/.*"estimate":\([0-9][0-9]*\).*/\1/p')
		case "$input" in *'"estimate":null'*) new_points=none ;; esac
		new_due=$(field dueDate)
		case "$input" in *'"dueDate":null'*) new_due=none ;; esac
		for each in $ids; do
			[ -n "$value" ] && printf '%s\tstate\t%s\n' "$each" "$value" >>"$changed"
			[ -n "$new_title" ] && printf '%s\ttitle\t%s\n' "$each" "$new_title" >>"$changed"
			[ -n "$new_priority" ] && printf '%s\tpriority\t%s\n' "$each" "$new_priority" >>"$changed"
			[ -n "$new_who" ] && printf '%s\tassignee\t%s\n' "$each" "$new_who" >>"$changed"
			[ -n "$added" ] && printf '%s\taddLabel\t%s\n' "$each" "$added" >>"$changed"
			[ -n "$removed" ] && printf '%s\tremoveLabel\t%s\n' "$each" "$removed" >>"$changed"
			[ -n "$new_cycle" ] && printf '%s\tcycle\t%s\n' "$each" "$new_cycle" >>"$changed"
			[ -n "$new_points" ] && printf '%s\testimate\t%s\n' "$each" "$new_points" >>"$changed"
			[ -n "$new_due" ] && printf '%s\tdue\t%s\n' "$each" "$new_due" >>"$changed"
		done
		return 0
	}
	case "${STANDIN_CHANGE-}" in
	refused)
		cat "$here/change-refused.json"
		printf '\n400'
		exit 0
		;;
	lost)
		remember_change
		echo "curl: (28) Operation timed out" >&2
		exit 28
		;;
	esac
	remember_change
	nodes=""
	for each in $ids; do
		nodes="${nodes}${nodes:+,}$(changed_node "$each")"
	done
	NODES="$nodes" awk '{ i = index($0, "@NODES@"); print substr($0, 1, i - 1) ENVIRON["NODES"] substr($0, i + 7) }' "$here/issue-batch-update.json"
	printf '\n200'
	exit 0
fi

if is Issue; then
	want=$(printf '%s' "$plain" | sed -n 's/.*"variables":{"id":"\([^"]*\)".*/\1/p')
	if [ -n "$created" ] && [ -f "$created" ] && [ "$want" = "$(sed -n 1p "$created")" ]; then
		id=$want
		title=$(sed -n 2p "$created")
		printf '{"data":{"issue":'
		fill "$here/created-issue.json"
		printf '}}\n200'
		exit 0
	fi
	case "$want" in
	????????-????-????-????-????????????)
		printf '{"data":{"issue":null},"errors":[{"message":"Entity not found: Issue"}]}\n200'
		exit 0
		;;
	esac
	case "${STANDIN_ISSUE-}" in
	todo)
		sed -e 's/"id": "s-prog"/"id": "s-todo"/' -e 's/"name": "In Progress"/"name": "Todo"/' \
			-e 's/"type": "started"/"type": "unstarted"/' "$here/issue.json"
		;;
	family) cat "$here/issue-family.json" ;;
	pictures) cat "$here/issue-pictures.json" ;;
	moved)
		sed -e 's|stand-in/checkout.png|stand-in/moved.png|' -e 's|stand-in/trace.jpg|stand-in/moved-away.jpg|' \
			-e 's|stand-in/build.log|stand-in/moved-forever.log|' "$here/issue-pictures.json"
		;;
	pictures-uuid)
		sed 's/"id": "issue-412"/"id": "0c9e0f1e-6d1b-4d7a-9a56-3b1c0a5e7f10"/' "$here/issue-pictures.json"
		;;
	mine) sed 's/"displayName": "Mert"/"displayName": "Ada", "isMe": true/' "$here/issue.json" ;;
	odd-title)
		sed 's|"title": "Add rate limiting to the public API"|"title": "--yolo Add\\nrate \\u001b]0;owned\\u0007 limiting"|' "$here/issue.json"
		;;
	*) cat "$here/issue.json" ;;
	esac
	printf '\n200'
	exit 0
fi

# The closed issues of a list, asked for after its open ones (its filter takes the done and canceled
# kinds): the issues of its fixture that a change made done or canceled; none, where none was.
case "$plain" in
*'"type":{"in":["completed","canceled"]}'*)
	for list in MyIssues:my-issues.json AllIssues:all-issues.json TeamIssues:team-issues.json \
		CycleIssues:cycle-issues.json ViewIssues:view-issues.json ProjectIssues:project-issues.json \
		LabelIssues:label-issues.json; do
		if is "${list%%:*}"; then
			settle closed <"$here/${list#*:}"
			printf '\n200'
			exit 0
		fi
	done
	;;
esac

if is MyIssues; then
	if [ "${STANDIN_MY-}" = empty ]; then listing my-issues-empty.json; else listing my-issues.json; fi
	exit 0
fi
if is AllIssues; then listing all-issues.json; exit 0; fi
# The issues of one team, cycle, view, project or label (each a fixture of its own: they differ) and the
# names of the lists a person can go to. Nothing that was created or changed is told here.
if is TeamIssues; then
	# A team that has more than the pen takes: every page has a hundred issues and a next one.
	if [ "${STANDIN_LIST-}" = big ]; then cat "$here/team-issues-big.json"; else cat "$here/team-issues.json"; fi
	printf '\n200'
	exit 0
fi
if is CycleIssues; then cat "$here/cycle-issues.json"; printf '\n200'; exit 0; fi
if is ViewIssues; then cat "$here/view-issues.json"; printf '\n200'; exit 0; fi
if is ProjectIssues; then cat "$here/project-issues.json"; printf '\n200'; exit 0; fi
if is LabelIssues; then cat "$here/label-issues.json"; printf '\n200'; exit 0; fi
# A search finds the same six issues whatever the words are (the closed ones too), and what the filters
# offer is one file; a list asked with filters answers as it does without (the tests read what was
# sent in the log).
if is SearchIssues; then cat "$here/search-issues.json"; printf '\n200'; exit 0; fi
if is FilterOptions; then cat "$here/filter-options.json"; printf '\n200'; exit 0; fi
if is ListFavorites; then cat "$here/list-favorites.json"; printf '\n200'; exit 0; fi
if is ListTeams; then cat "$here/list-teams.json"; printf '\n200'; exit 0; fi
if is ListViews; then cat "$here/list-views.json"; printf '\n200'; exit 0; fi
if is ListProjects; then cat "$here/list-projects.json"; printf '\n200'; exit 0; fi
if is Verify; then cat "$here/verify.json"; printf '\n200'; exit 0; fi
if is NewIssueTeams; then cat "$here/teams.json"; printf '\n200'; exit 0; fi
if is NewIssueOptions; then
	# The team of the web has no cycles and does not estimate; any other team is Acme.
	team=$(printf '%s' "$plain" | sed -n 's/.*"variables":{"team":"\([^"]*\)".*/\1/p')
	if [ -f "$here/new-issue-options-$team.json" ]; then
		cat "$here/new-issue-options-$team.json"
	else
		cat "$here/new-issue-options.json"
	fi
	printf '\n200'
	exit 0
fi

echo "stand-in curl: a query it does not know" >&2
exit 2
